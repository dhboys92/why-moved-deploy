# DART OpenAPI 키 (필수) — https://opendart.fss.or.kr 에서 무료 발급
DART_API_KEY=

# 캐시 DB 경로 (기본값 data/cache.db)
CACHE_DB_PATH=data/cache.db

# 외부 API 타임아웃(초)
HTTP_TIMEOUT_SECONDS=5

# 서버 바인딩
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# 차트 URL 생성용 공개 베이스 URL (배포 시 설정)
PUBLIC_BASE_URL=http://localhost:8000

# market-data-collector 베이스 URL (선택) — 종목명 보충 조회(screen_stocks)에 사용, 비우면 비활성
MARKET_DATA_BASE_URL=

# 컨테이너용 collector 주소 오버라이드 (docker-compose가 MARKET_DATA_BASE_URL로 주입)
# 로컬: 비워두면 기본값 http://host.docker.internal:7000
# 운영(같은 onedesk-network-koscom): http://market-data-api:8000
MARKET_DATA_BASE_URL_DOCKER=
